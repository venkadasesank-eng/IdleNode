# ============================================================
# IdleNode Campus Computing Platform - Environment Configuration
# ============================================================

# Backend API Base URL (without trailing slash)
# In development (Vite dev server with proxy), this can be left as /api or http://127.0.0.1:8000/api
# In production, set to your publicly accessible API domain, e.g. https://idlenode.campus.edu/api
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# WebSocket Server Base URL
# In development, ws://127.0.0.1:8000
# In production, wss://idlenode.campus.edu
VITE_WS_BASE_URL=ws://127.0.0.1:8000

# Interactive Swagger UI Documentation URL
# In development, http://127.0.0.1:8000/docs
# In production, https://idlenode.campus.edu/docs
VITE_SWAGGER_DOCS_URL=http://127.0.0.1:8000/docs
