# ===================================================
# IdleNode Campus Computing Platform - Environment Configuration
# ===================================================

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_WS_BASE_URL=ws://127.0.0.1:8000

# Backend Configuration
PROJECT_NAME="IdleNode Campus Computing Platform"
VERSION=1.0.0
DEBUG=True
DEMO_MODE=True

# Security & Secrets (Replace with secure random keys in production)
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for local dev, PostgreSQL for live campus deployment)
DATABASE_URL=sqlite:///./idlenode.db
# DATABASE_URL=postgresql://idlenode_user:password@localhost:5432/idlenode_campus

# Campus Policy & Timezone Defaults
TIMEZONE=Asia/Kolkata
DAILY_CREDIT_ALLOWANCE=100
CREDIT_RESET_HOUR=0
CREDIT_RESET_MINUTE=0
MAX_CONCURRENT_SESSIONS_PER_STUDENT=1
MAX_SESSION_MINUTES=240
DISCONNECT_GRACE_PERIOD_SECONDS=300

# Hourly Resource Metering Rates (in Credits per Hour)
RATE_GENERAL_DESKTOP=5
RATE_DEV_CPU=8
RATE_DATA_SCIENCE=12
RATE_ML_GPU=25
RATE_SIMULATION=18

# Remote Desktop Gateway Integration
# Real deployment connects to an Apache Guacamole (guacd) daemon running on campus controller
GUACAMOLE_URL=ws://127.0.0.1:4822
GUACAMOLE_AUTH_TOKEN=your-guacamole-tunnel-secret

# Worker Agent Registration Secret
WORKER_SHARED_SECRET=your-institution-worker-registration-secret-key

# Storage Volumes
STORAGE_BASE_DIR=./storage
PERSISTENT_QUOTA_BYTES=5368709120 # 5 GB
